<!DOCTYPE html>
<html data-bs-theme="dark">
<head>
    <title>Metastore Admin - Compaction - {{ if .Segments }}Segments{{ else }}{{ .Tenant }}{{ end }}</title>
    {{ template "compaction-head" . }}
</head>
<body>
<main>
    <div class="container mt-5">
        {{ template "compaction-page-header" . }}

        <div class="row my-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/metastore-compaction">Compaction</a></li>
                    <li class="breadcrumb-item active" aria-current="page">
                        {{ if .Segments }}Multi-tenant segments{{ else }}{{ .Tenant }}{{ end }}
                    </li>
                </ol>
            </nav>
            {{ if .Segments }}
                <h2>
                    Multi-tenant segments
                    {{ template "compaction-info" "Blocks of compaction level 0 are the segments written by the segment writers. A segment holds the data of many tenants, so it carries no tenant of its own, and neither do the compaction jobs and queues that operate on it. They are collected here because they cannot be addressed by tenant name." }}
                </h2>
            {{ else }}
                <h2 class="font-monospace">{{ .Tenant }}</h2>
            {{ end }}
            <p class="text-body-secondary">
                Compaction jobs and planner queues of a single tenant. The jobs are listed in the
                scheduling order within each level; the queues hold the blocks that await compaction
                and have not been turned into jobs yet.
            </p>
            <p class="text-body-secondary">
                Where the scheduler reports them, the block count expands into the individual source
                blocks, each linking to the object store browser. Otherwise the count links to the
                block listing of the tenant, narrowed to the time window the blocks are expected to
                fall into &mdash; a hint, not an exact match, since that listing covers every block
                of the tenant in the window, at every shard and level.
            </p>
            {{ if .Segments }}
                <p class="text-body-secondary">
                    Segment links address the object store browser under the
                    <code>anonymous</code> tenant
                    {{ template "compaction-info" "Segments are stored under the anonymous tenant directory because they belong to no single tenant. The name only identifies the page in the browser: the block itself is resolved by its shard and identifier, with an empty block tenant." }}
                    rather than a tenant name.
                </p>
            {{ end }}
            {{ if .BlocksPath }}
                <div class="col-12 mb-2">
                    <a class="btn btn-outline-secondary btn-sm" href="{{ .BlocksPath }}">
                        <i class="bi bi-box"></i> Browse all blocks of this tenant
                    </a>
                </div>
            {{ end }}
        </div>

        {{ if .Empty }}
            <div class="row gy-4">
                <div class="col-12">
                    <div class="alert alert-secondary" role="alert">
                        {{ if .Segments }}
                            No compaction jobs and no queued blocks for the multi-tenant segments:
                            every segment has been compacted into per-tenant blocks.
                        {{ else }}
                            No compaction jobs and no queued blocks for this tenant. Either the tenant does not
                            exist, or all of its blocks have been compacted.
                        {{ end }}
                    </div>
                </div>
            </div>
        {{ else }}
            <div class="row gy-4">
                <h2>Summary</h2>
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-detail-row">
                                <div class="card-detail-label">Jobs:</div>
                                <div class="card-detail-value">{{ .TotalJobs }}</div>
                            </div>
                            <div class="card-detail-row">
                                <div class="card-detail-label">Status:</div>
                                <div class="card-detail-value">{{ template "compaction-status-badges" . }}</div>
                            </div>
                            <div class="card-detail-row">
                                <div class="card-detail-label">Job lease duration:</div>
                                <div class="card-detail-value">{{ .LeaseDuration }}</div>
                            </div>
                            <div class="card-detail-row">
                                <div class="card-detail-label">Job failure threshold:</div>
                                <div class="card-detail-value">{{ .MaxFailures }}</div>
                            </div>
                            <div class="card-detail-row">
                                <div class="card-detail-label">Blocks awaiting compaction:</div>
                                <div class="card-detail-value">
                                    {{ if .QueuesTruncated }}at least {{ end }}{{ .QueuedBlocks }}
                                    in {{ if .QueuesTruncated }}at least {{ end }}{{ .TotalQueues }} planner queues
                                    {{ if .QueuesTruncated }}
                                        {{ template "compaction-info" "The metastore stopped scanning the planner queues before reaching the end, so these are lower bounds, and queues of this tenant may be missing entirely." }}
                                    {{ end }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row gy-4">
                <h2>
                    Jobs by Level
                    {{ template "compaction-info" "Jobs of lower compaction levels are prioritized: no job is assigned at a level until all eligible jobs of lower levels are assigned. The priority is global, not per tenant." }}
                </h2>
                {{ template "compaction-levels-table" .Levels }}
            </div>

            <div class="row gy-4">
                <h2>
                    Jobs
                    {{ template "compaction-info" "Jobs are listed in the scheduling order within each level. Reassignments counts expired leases: the job is excluded from assignment when it reaches the failure threshold. The token is the fencing token of the current assignment (the raft log index at assignment time)." }}
                </h2>
                {{ if .TruncatedJobs }}
                    <div class="col-12">
                        <div class="alert alert-warning" role="alert">
                            Showing the first {{ len .Jobs }} jobs in the scheduling order; {{ .TruncatedJobs }} more
                            jobs are not displayed. The summary sections above cover all the jobs of the tenant.
                        </div>
                    </div>
                {{ end }}
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped">
                        <thead>
                        <tr>
                            <th>Name</th>
                            <th>Shard</th>
                            <th>Level</th>
                            <th>Status</th>
                            <th>Worker</th>
                            <th>Reassignments</th>
                            <th>
                                Blocks
                                {{ template "compaction-info" "Number of source blocks the job compacts. Expands into the individual blocks where the scheduler reports their identifiers. Otherwise it follows to the block listing of the tenant, windowed around the time the job was created, which is not restricted to the source blocks of the job." }}
                            </th>
                            <th>Age</th>
                            <th>Assigned</th>
                            <th>Lease</th>
                            <th>Token</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{ range .Jobs }}
                            <tr>
                                <td class="align-middle font-monospace small">{{ .Name }}</td>
                                <td class="align-middle">{{ .Shard }}</td>
                                <td class="align-middle">{{ .Level }}</td>
                                <td class="align-middle"><span class="badge text-bg-{{ .StatusBadge }}">{{ .Status }}</span></td>
                                <td class="align-middle font-monospace small">{{ .Worker }}</td>
                                <td class="align-middle">{{ .Reassignments }}</td>
                                {{ template "compaction-blocks-cell" . }}
                                <td class="align-middle">{{ .Age }}</td>
                                <td class="align-middle">{{ .Assigned }}</td>
                                <td class="align-middle">{{ .Lease }}</td>
                                <td class="align-middle font-monospace small">{{ .Token }}</td>
                            </tr>
                        {{ else }}
                            <tr>
                                <td colspan="11" class="text-body-secondary">No compaction jobs for this tenant.</td>
                            </tr>
                        {{ end }}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row gy-4">
                <h2>
                    Planner Queues
                    {{ template "compaction-info" "Blocks awaiting compaction, queued per shard and level. New jobs are created from these queues on demand, when workers report spare capacity." }}
                </h2>
                {{ if .TruncatedQueues }}
                    <div class="col-12">
                        <div class="alert alert-warning" role="alert">
                            Showing the first {{ len .Queues }} queues ordered by level and shard;
                            {{ .TruncatedQueues }} more queues are not displayed. The blocks awaiting
                            compaction counter above covers all the queues of the tenant.
                        </div>
                    </div>
                {{ end }}
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped">
                        <thead>
                        <tr>
                            <th>Shard</th>
                            <th>Level</th>
                            <th>
                                Blocks
                                {{ template "compaction-info" "Number of blocks awaiting compaction in the queue. Follows to the block listing of the tenant, windowed by the oldest and the newest queue entries. The listing is not restricted to the blocks of this queue: it covers every shard and level of the tenant in that window." }}
                            </th>
                            <th>Oldest Block</th>
                            <th>Newest Block</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{ range .Queues }}
                            <tr>
                                <td class="align-middle">{{ .Shard }}</td>
                                <td class="align-middle">{{ .Level }}</td>
                                <td class="align-middle">
                                    {{ if .BlocksPath }}
                                        <a href="{{ .BlocksPath }}">{{ .Blocks }}</a>
                                    {{ else }}
                                        {{ .Blocks }}
                                    {{ end }}
                                </td>
                                <td class="align-middle">{{ .OldestBlock }}</td>
                                <td class="align-middle">{{ .NewestBlock }}</td>
                            </tr>
                        {{ else }}
                            <tr>
                                <td colspan="5" class="text-body-secondary">No blocks are awaiting compaction.</td>
                            </tr>
                        {{ end }}
                        </tbody>
                    </table>
                </div>
            </div>
        {{ end }}
    </div>
</main>
{{ template "compaction-scripts" . }}
</body>
</html>
